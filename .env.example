# Full Cookie request header from a logged-in taxer.ua tab.
# Quote the value so semicolons stay inside it.
# Copy it from DevTools → Network → a taxer.ua request → Headers → Cookie.
# session_hash alone is not enough. Include PHPSESSID, session_key,
# session_hash, and session_key_hash. See README.
TAXER_COOKIE="PHPSESSID=replace-me; session_key=replace-me; session_hash=replace-me; session_key_hash=replace-me"

# Optional. Defaults are the live site and the Ukrainian UI.
TAXER_BASE_URL=https://taxer.ua
TAXER_LANG=uk

# Optional. Google Workspace Gmail remote MCP (.cursor/mcp.json → gmail-mcp).
# Setup: https://developers.google.com/workspace/gmail/api/guides/configure-mcp-server
# OAuth Web application client; redirect URIs must include Cursor callbacks (see README).
# Remote MCP reads these via ${env:...} — export before starting Cursor or load .env into your shell (envFile applies to taxer stdio only).
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
# Required by scripts/create_gmail_draft_with_attachment.py (not gmail-mcp).
GMAIL_REFRESH_TOKEN=

# Optional: invoice automation recipients (use in your private automation prompt or AGENTS.local.md).
# INVOICE_EMAIL_TO=
# INVOICE_EMAIL_CC=
