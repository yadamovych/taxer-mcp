# Full Cookie request header from a logged-in taxer.ua tab.
# Quote the value so the semicolons stay part of the cookie.
# It must include XSRF-TOKEN and the session cookie. See README.
TAXER_COOKIE="XSRF-TOKEN=replace-me; session=replace-me"

# Optional. Defaults are the live site and the Ukrainian UI.
TAXER_BASE_URL=https://taxer.ua
TAXER_LANG=uk
